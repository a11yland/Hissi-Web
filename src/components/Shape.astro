---
/** One status shape from the sprite. Always decorative: the word stands next to it. */
import type { Status } from '../i18n/de';

interface Props {
  status: Status;
  class?: string;
}

const { status, class: className } = Astro.props;
---

<svg class:list={['shape', status, className]} aria-hidden="true" focusable="false">
  <use href={`#s-${status}`}></use>
</svg>

---
import Floor from '../Floor.astro';
import Shape from '../Shape.astro';
import { type Locale, t } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const s = t(locale).forms;
---

<Floor id="formen" num={s.num} tag={s.tag} ground="is-lila" labelledby="f1-title">
  <h2 id="f1-title">{s.h2}</h2>
  <p class="intro">{s.intro}</p>
  <ul class="forms">
    {
      s.items.map((item) => (
        <li>
          <Shape status={item.status} />
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </li>
      ))
    }
  </ul>
  <p class="honesty">{s.honesty}</p>
</Floor>

<style>
  .honesty {
    margin-top: clamp(2rem, 5vw, 3rem);
    max-width: 40rem;
    font-weight: 700;
  }
</style>

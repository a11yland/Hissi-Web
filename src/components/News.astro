---
/** The news page body: the changelog of both apps in one paper floor, newest first. */
import { render } from 'astro:content';
import NewsMeta from './NewsMeta.astro';
import { type Locale, t } from '../i18n';
import { anchorOf, newsFor } from '../news';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const s = t(locale).news;
const entries = await Promise.all(
  (await newsFor(locale)).map(async (entry) => ({ entry, id: anchorOf(entry), Content: (await render(entry)).Content })),
);
---

<section class="floor is-paper" aria-labelledby="page-title">
  <div class="wrap">
    <p class="tag">{s.tag}</p>
    <h1 id="page-title">{s.h1}</h1>
    <p class="intro">{s.intro}</p>
    <div class="entries">
      {
        entries.map(({ entry, id, Content }) => (
          <article class="card" id={id} aria-labelledby={`${id}-title`}>
            <h2 id={`${id}-title`}>{entry.data.title}</h2>
            <NewsMeta locale={locale} entry={entry} />
            <div class="body">
              <Content />
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  h1 {
    font-size: var(--step-2);
  }
  .entries {
    margin-top: clamp(2rem, 5vw, 3rem);
    display: grid;
    gap: 1rem;
    max-width: 44rem;
  }
  .card {
    background: var(--bg);
  }
  .card h2 {
    font-size: var(--step-1);
    letter-spacing: -0.01em;
  }
  .body {
    display: grid;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }
  .body :global(ul) {
    margin: 0;
    padding-left: 1.4em;
  }
  .body :global(li + li) {
    margin-top: 0.5rem;
  }
</style>

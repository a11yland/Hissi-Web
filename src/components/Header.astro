---
import Lockup from './brand/Lockup.astro';
import FloorDisplay from './FloorDisplay.astro';
import LangSwitch from './LangSwitch.astro';
import { recruiting } from '../config';
import { href, paths, type Locale, type PageKey, t } from '../i18n';

interface Props {
  locale: Locale;
  pageKey?: PageKey;
}

const { locale, pageKey } = Astro.props;
const s = t(locale);
const isHome = pageKey === 'home';
const roof = isHome ? '#dach' : `${href(paths.home[locale])}#dach`;
---

<header class="top">
  <div class="wrap">
    <a class="brand" href={isHome ? '#inhalt' : href(paths.home[locale])} aria-label={s.nav.brand}>
      <Lockup class="lockup mk" animated />
    </a>
    <div class="tools">
      {recruiting() && <a class="cta" href={roof}>{s.nav.test}</a>}
      {isHome && <FloorDisplay initial={s.eg.num} />}
      {pageKey && <LangSwitch locale={locale} pageKey={pageKey} />}
    </div>
  </div>
</header>

<style>
  .tools {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .cta {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding-inline: 0.9rem;
    border: 2px solid var(--lila);
    border-radius: 0.5rem;
    background: var(--lila);
    color: var(--on-lila);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-weight: 700;
    text-decoration: none;
  }
  .cta:hover {
    border-color: var(--fg);
  }
  /* The floor counter is decorative; on narrow screens the call to action takes its room. */
  @media (max-width: 40rem) {
    .tools :global(.floor-display) {
      display: none;
    }
  }
</style>
